# The absolute origin this deployment serves from. Metadata, canonical links, Open Graph and
# the sitemap all need it; unset, a social scraper is handed localhost. It is read at BUILD
# time, not at start: robots.txt and sitemap.xml are prerendered, so the value has to be
# present for `npm run build` or the built files carry localhost.
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_DEBUG_3D=false
NEXT_PUBLIC_FORCE_QUALITY=auto
FORGE_ALLOWED_CONTENT_HOSTS=content.example.com
FORGE_CONTENT_MAIN_HEADERS={"authorization":"Bearer replace-me"}
SHOPIFY_STOREFRONT_MAIN_TOKEN=
FORGE_TELEMETRY_WEBHOOK_URL=
# Lead capture. The webhook receives each validated enquiry as JSON over HTTPS; with it unset
# leads are written to structured server output instead of being dropped. The token secret
# signs short-lived brochure grants -- without it the enquiry is still recorded but no
# download link is issued. Use a long random value and rotate it to revoke outstanding links.
FORGE_LEAD_WEBHOOK_URL=
FORGE_LEAD_TOKEN_SECRET=
VERCEL_TOKEN=
VERCEL_ORG_ID=
VERCEL_PROJECT_ID=
FORGE_STUDIO_PUBLISH_ENABLED=false
FORGE_STUDIO_PUBLISH_SECRET=
FORGE_GITHUB_REPOSITORY=owner/repository
FORGE_GITHUB_TOKEN=

# Server-only credentials for Forge Asset Creator. Never expose these as NEXT_PUBLIC_* values.
MESHY_API_KEY=
HF_API_KEY_ID=
HF_API_KEY_SECRET=

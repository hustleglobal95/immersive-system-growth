# The absolute origin this deployment serves from. Metadata, canonical links, Open Graph and
# the sitemap all need it; unset, a social scraper is handed localhost. It is read at BUILD
# time, not at start: robots.txt and sitemap.xml are prerendered, so the value has to be
# present for `npm run build` or the built files carry localhost.
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_DEBUG_3D=false
NEXT_PUBLIC_FORCE_QUALITY=auto
FORGE_ALLOWED_CONTENT_HOSTS=content.example.com
FORGE_CONTENT_MAIN_HEADERS={"authorization":"Bearer replace-me"}
SHOPIFY_STOREFRONT_MAIN_TOKEN=
FORGE_TELEMETRY_WEBHOOK_URL=
# Lead capture. The webhook receives each validated enquiry as JSON over HTTPS; with it unset
# leads are written to structured server output instead of being dropped. The token secret
# signs short-lived brochure grants -- without it the enquiry is still recorded but no
# download link is issued. Use a long random value and rotate it to revoke outstanding links.
FORGE_LEAD_WEBHOOK_URL=
FORGE_LEAD_TOKEN_SECRET=
VERCEL_TOKEN=
VERCEL_ORG_ID=
VERCEL_PROJECT_ID=
FORGE_STUDIO_PUBLISH_ENABLED=false
FORGE_STUDIO_PUBLISH_SECRET=
FORGE_GITHUB_REPOSITORY=owner/repository
FORGE_GITHUB_TOKEN=

# Local-only durable storage fallback. npm run studio:local enables this automatically.
# Ignored in production even if set.
FORGE_LOCAL_STORAGE_ENABLED=false

# Studio -> GitHub Actions closed-loop runner. Leave false until forge-loop.yml exists on the
# production branch and repository Actions secrets FORGE_VISUAL_CRITIC_URL / TOKEN are configured.
FORGE_LOOP_REMOTE_ENABLED=false

# Server-only credentials for Forge Asset Creator. Never expose these as NEXT_PUBLIC_* values.
MESHY_API_KEY=
HF_API_KEY_ID=
HF_API_KEY_SECRET=

# Server-only Visual Director multimodal critic. Keep tokens off the client.
FORGE_VISUAL_CRITIC_URL=
FORGE_VISUAL_CRITIC_TOKEN=

# Built-in comparative visual critic fallback via Vercel AI Gateway.
# On Vercel, VERCEL_OIDC_TOKEN may authenticate local deployment calls automatically;
# GitHub Actions remote loops should receive AI_GATEWAY_API_KEY as a repository secret.
AI_GATEWAY_API_KEY=
FORGE_AI_GATEWAY_VISUAL_MODEL=openai/gpt-5.4

# Optional server-only fixed-timestep motion sequence critic.
FORGE_MOTION_CRITIC_URL=
FORGE_MOTION_CRITIC_TOKEN=

# Evidence-backed Director judgment. The URL must accept rendered captures and return the
# documented judgment schema. Calibration JSON is a non-secret benchmark record containing:
# version,id,judgeId,benchmarkSetId,reviewedAt,sampleSize,pairwiseAgreement,lockPrecision,
# falseLockRate,reviewer. Forge rejects weak calibration and stays UNVERIFIED without it.
FORGE_DIRECTOR_JUDGE_URL=
FORGE_DIRECTOR_JUDGE_TOKEN=
FORGE_DIRECTOR_JUDGE_CALIBRATION_JSON=
# When using the built-in AI Gateway Director backend, calibration judgeId must equal
# ai-gateway:<model>, for example ai-gateway:openai/gpt-5.4.
FORGE_AI_GATEWAY_DIRECTOR_MODEL=openai/gpt-5.4


# Forge Studio authoring perimeter. Authentication is ON unless explicitly disabled.
# For solo local work, prefer `npm run studio:local` rather than editing this file.
# Production/shared authoring should keep auth enabled and configure real users.
# Production authoring is completely unavailable unless ENABLE_STUDIO_IN_PROD=true.
# Generate each secretHash with: npm run internal:user-hash -- '<long passphrase>'
STUDIO_AUTH_ENABLED=true
ENABLE_STUDIO_IN_PROD=false
FORGE_INTERNAL_SESSION_SECRET=
FORGE_INTERNAL_USERS_JSON=[]

# Durable Project Vault. Uses the existing server-only GitHub repository/token on a separate branch.
FORGE_VAULT_BRANCH=forge-vault
FORGE_VAULT_BASE_BRANCH=main

# Permanent generated-asset storage. Endpoint contract: authenticated PUT <endpoint>/<project>/<sha-prefix>/<sha-name.ext>
# Public base must expose the exact same object key over HTTPS.
FORGE_ASSET_VAULT_ENDPOINT=
FORGE_ASSET_VAULT_PUBLIC_BASE_URL=
FORGE_ASSET_VAULT_TOKEN=

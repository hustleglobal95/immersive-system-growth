{
  "version": 1,
  "activeMode": "scroll-storytelling",
  "modes": [
    {
      "id": "scroll-storytelling",
      "label": "Scroll Storytelling",
      "summary": "Chapter-based narrative with pinned scenes, reversible transitions and synchronized camera choreography.",
      "composition": { "narrative": "chapters", "navigation": "standard", "typography": "balanced", "interaction": "scroll", "cues": "standard" },
      "requirements": { "minimumScenes": 3, "webgl": "enhanced", "productRig": false },
      "fallback": "semantic-document",
      "reducedMotion": "linear-document"
    },
    {
      "id": "floating-navigation",
      "label": "Floating Navigation",
      "summary": "Contextual navigation that docks, expands and follows the active chapter without obscuring the experience.",
      "composition": { "narrative": "editorial", "navigation": "floating", "typography": "balanced", "interaction": "scroll", "cues": "standard" },
      "requirements": { "minimumScenes": 2, "webgl": "optional", "productRig": false },
      "fallback": "semantic-document",
      "reducedMotion": "linear-document"
    },
    {
      "id": "interactive-cards",
      "label": "Interactive Cards",
      "summary": "A scene-linked card deck with keyboard, pointer and touch-safe chapter selection and expansion.",
      "composition": { "narrative": "cards", "navigation": "minimal", "typography": "balanced", "interaction": "cards", "cues": "standard" },
      "requirements": { "minimumScenes": 3, "webgl": "optional", "productRig": false },
      "fallback": "static-cards",
      "reducedMotion": "static-cards"
    },
    {
      "id": "big-hero-type",
      "label": "Big Hero Type",
      "summary": "Oversized editorial headlines composed with imagery, video and the persistent WebGL world.",
      "composition": { "narrative": "editorial", "navigation": "minimal", "typography": "hero", "interaction": "scroll", "cues": "standard" },
      "requirements": { "minimumScenes": 2, "webgl": "optional", "productRig": false },
      "fallback": "semantic-document",
      "reducedMotion": "linear-document"
    },
    {
      "id": "3d-product-view",
      "label": "3D Product View",
      "summary": "Product-centered inspection with orbit controls, scene choreography, hotspots and deterministic rig animation.",
      "composition": { "narrative": "product", "navigation": "minimal", "typography": "balanced", "interaction": "orbit", "cues": "guided" },
      "requirements": { "minimumScenes": 2, "webgl": "required", "productRig": true },
      "fallback": "poster-inspection",
      "reducedMotion": "static-inspection"
    },
    {
      "id": "motion-cues",
      "label": "Motion Cues",
      "summary": "Directional indicators, progress, scene context and restrained micro-motion that continuously guide the journey.",
      "composition": { "narrative": "chapters", "navigation": "standard", "typography": "balanced", "interaction": "guided", "cues": "guided" },
      "requirements": { "minimumScenes": 3, "webgl": "optional", "productRig": false },
      "fallback": "semantic-document",
      "reducedMotion": "linear-document"
    }
  ]
}

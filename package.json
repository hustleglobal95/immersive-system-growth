{
  "name": "immersive-site-forge",
  "version": "5.0.0",
  "private": true,
  "description": "A production starter for cinematic, scroll-driven 3D websites using Next.js, React Three Fiber, GSAP, Lenis, and a persistent WebGL world.",
  "license": "MIT",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "node scripts/prepare-decoders.mjs && next dev",
    "build": "node scripts/prepare-decoders.mjs && next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "doctor": "node scripts/doctor.mjs",
    "experience:validate": "node --import tsx scripts/validate-experience.mjs",
    "interaction:validate": "node --import tsx scripts/validate-interactions.mjs",
    "assets:audit": "node scripts/audit-assets.mjs",
    "assets:optimize": "node scripts/optimize-assets.mjs",
    "scene:new": "node scripts/new-scene.mjs",
    "recipe:list": "node scripts/recipe-list.mjs",
    "recipe:apply": "node --import tsx scripts/apply-recipe.mjs",
    "test": "node --import tsx --test tests/*.test.ts",
    "check": "npm run doctor && npm run project:validate && npm run experience:validate && npm run interaction:validate && npm run cinematic:audit && npm run rig:audit && npm run assets:audit && npm run test && npm run typecheck && npm run lint",
    "cinematic:audit": "node --import tsx scripts/cinematic-audit.mjs",
    "rig:audit": "node --import tsx scripts/rig-audit.mjs",
    "glb:inspect": "node --import tsx scripts/inspect-glb.mjs",
    "project:new": "node --import tsx scripts/new-project.mjs",
    "project:activate": "node --import tsx scripts/activate-project.mjs",
    "project:validate": "node --import tsx scripts/validate-projects.mjs",
    "content:sync": "node --import tsx scripts/sync-content.mjs",
    "scene:report": "node scripts/scene-report.mjs",
    "test:browser": "playwright test",
    "assets:generate": "node scripts/generate-assets.mjs",
    "test:configs": "node scripts/test-configs.mjs"
  },
  "dependencies": {
    "@fontsource-variable/cormorant-garamond": "5.3.0",
    "@fontsource-variable/dm-sans": "5.3.0",
    "@fontsource-variable/manrope": "5.3.0",
    "@react-three/drei": "10.7.8",
    "@react-three/fiber": "9.7.0",
    "@react-three/postprocessing": "3.1.1",
    "gsap": "3.15.0",
    "lenis": "1.3.26",
    "next": "16.3.4",
    "postprocessing": "6.39.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sharp": "0.35.4",
    "three": "0.185.1",
    "zod": "4.6.1",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "0.185.0",
    "eslint": "9.39.5",
    "eslint-config-next": "^16.0.0",
    "tsx": "4.23.13",
    "typescript": "^5.8.0"
  }
}

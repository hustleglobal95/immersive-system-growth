{
  "version": 1,
  "schemaVersion": 2,
  "id": "david-weekley-marketplace-concept",
  "name": "David Weekley Homes / FORGE Marketplace Concept",
  "description": "Canonical FORGE project manifest for a search-led, interactive homebuyer marketplace concept.",
  "paths": {
    "experience": "config/experience.json",
    "studioProject": "config/studio-project.json",
    "creativeDirection": "config/creative-direction.json",
    "assetManifest": "config/asset-manifest.json",
    "visualSystems": "config/visual-systems.json",
    "experienceModes": "config/experience-modes.json"
  },
  "performance": {
    "initialCriticalMb": 8,
    "scenePreloadMb": 20,
    "maxActiveMb": 96,
    "maxTotalMb": 240,
    "maxDrawCalls": 220,
    "maxTriangles": 700000,
    "targetFps": 60
  },
  "capabilities": {
    "webgl": "enhanced",
    "webgpu": "off",
    "xr": "off",
    "spatialAudio": "off"
  },
  "engineering": {
    "strictInvariants": true,
    "commandTransactions": true,
    "performanceRegressionGate": true,
    "visualEvidenceRequired": true
  },
  "release": {
    "provider": "vercel",
    "productionBranch": "main",
    "requireReview": true,
    "immutableAssets": true
  }
}

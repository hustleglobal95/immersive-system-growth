{
  "version": 1,
  "id": "weekley-marketplace-interactions",
  "initialState": "browsing",
  "states": ["browsing", "comparing", "personalizing", "tour-intent"],
  "variables": {
    "searched": false,
    "comparison-started": false,
    "gallery-selected": false
  },
  "nodes": [
    {
      "id": "run-home-search",
      "kind": "trigger",
      "label": "Run guided home search",
      "position": { "x": 40, "y": 80 },
      "event": "click",
      "target": "market-search",
      "states": ["browsing"]
    },
    {
      "id": "mark-searched",
      "kind": "action",
      "label": "Record guided search",
      "position": { "x": 300, "y": 80 },
      "action": { "type": "set-variable", "key": "searched", "value": true }
    },
    {
      "id": "compare-market",
      "kind": "trigger",
      "label": "Compare a market path",
      "position": { "x": 40, "y": 250 },
      "event": "click",
      "target": "compare-community",
      "states": ["browsing", "comparing"]
    },
    {
      "id": "mark-comparison",
      "kind": "action",
      "label": "Record comparison start",
      "position": { "x": 300, "y": 250 },
      "action": { "type": "set-variable", "key": "comparison-started", "value": true }
    },
    {
      "id": "state-comparing",
      "kind": "state",
      "label": "Comparing options",
      "position": { "x": 560, "y": 250 },
      "state": "comparing"
    },
    {
      "id": "select-home-gallery",
      "kind": "trigger",
      "label": "Select home gallery view",
      "position": { "x": 40, "y": 420 },
      "event": "click",
      "target": "select-gallery",
      "states": ["browsing", "comparing", "personalizing"]
    },
    {
      "id": "mark-gallery",
      "kind": "action",
      "label": "Record gallery selection",
      "position": { "x": 300, "y": 420 },
      "action": { "type": "set-variable", "key": "gallery-selected", "value": true }
    },
    {
      "id": "state-personalizing",
      "kind": "state",
      "label": "Personalizing home",
      "position": { "x": 560, "y": 420 },
      "state": "personalizing"
    },
    {
      "id": "request-tour",
      "kind": "trigger",
      "label": "Plan an in-person visit",
      "position": { "x": 40, "y": 590 },
      "event": "click",
      "target": "schedule-tour",
      "states": ["browsing", "comparing", "personalizing"]
    },
    {
      "id": "state-tour-intent",
      "kind": "state",
      "label": "Tour intent",
      "position": { "x": 300, "y": 590 },
      "state": "tour-intent"
    },
    {
      "id": "emit-tour-intent",
      "kind": "action",
      "label": "Emit tour intent",
      "position": { "x": 560, "y": 590 },
      "action": {
        "type": "emit",
        "name": "home-tour-intent",
        "payload": { "experience": "david-weekley-marketplace-concept" }
      }
    }
  ],
  "edges": [
    { "id": "search-recorded", "from": "run-home-search", "to": "mark-searched", "branch": "always", "priority": 0 },
    { "id": "comparison-recorded", "from": "compare-market", "to": "mark-comparison", "branch": "always", "priority": 0 },
    { "id": "comparison-state", "from": "mark-comparison", "to": "state-comparing", "branch": "always", "priority": 0 },
    { "id": "gallery-recorded", "from": "select-home-gallery", "to": "mark-gallery", "branch": "always", "priority": 0 },
    { "id": "gallery-state", "from": "mark-gallery", "to": "state-personalizing", "branch": "always", "priority": 0 },
    { "id": "tour-state", "from": "request-tour", "to": "state-tour-intent", "branch": "always", "priority": 0 },
    { "id": "tour-emitted", "from": "state-tour-intent", "to": "emit-tour-intent", "branch": "always", "priority": 0 }
  ],
  "mobileSubstitutions": []
}

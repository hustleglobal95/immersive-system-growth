{
  "version": 1,
  "id": "nocterra-interactions",
  "initialState": "idle",
  "states": ["idle", "inspecting", "inquiry"],
  "variables": {
    "engaged": false
  },
  "nodes": [
    {
      "id": "enter-detail",
      "kind": "trigger",
      "label": "Enter automotive detail",
      "position": { "x": 40, "y": 80 },
      "event": "scene-enter",
      "sceneId": "detail",
      "states": ["idle"]
    },
    {
      "id": "mark-engaged",
      "kind": "action",
      "label": "Mark visitor engaged",
      "position": { "x": 300, "y": 80 },
      "action": { "type": "set-variable", "key": "engaged", "value": true }
    },
    {
      "id": "state-inspecting",
      "kind": "state",
      "label": "Inspecting state",
      "position": { "x": 560, "y": 80 },
      "state": "inspecting"
    },
    {
      "id": "open-hotspot",
      "kind": "trigger",
      "label": "Open a detail hotspot",
      "position": { "x": 40, "y": 260 },
      "event": "hotspot-open",
      "states": ["inspecting"]
    },
    {
      "id": "emit-inspection",
      "kind": "action",
      "label": "Emit inspection event",
      "position": { "x": 300, "y": 260 },
      "action": {
        "type": "emit",
        "name": "detail-inspected",
        "payload": { "experience": "nocterra" }
      }
    },
    {
      "id": "enter-threshold",
      "kind": "trigger",
      "label": "Cross the threshold",
      "position": { "x": 40, "y": 420 },
      "event": "scene-enter",
      "sceneId": "threshold",
      "states": ["idle", "inspecting"]
    },
    {
      "id": "emit-threshold",
      "kind": "action",
      "label": "Emit threshold event",
      "position": { "x": 300, "y": 420 },
      "action": {
        "type": "emit",
        "name": "residence-entered",
        "payload": { "experience": "nocterra" }
      }
    },
    {
      "id": "enter-horizon",
      "kind": "trigger",
      "label": "Reach horizon climax",
      "position": { "x": 40, "y": 580 },
      "event": "scene-enter",
      "sceneId": "horizon",
      "states": ["idle", "inspecting"]
    },
    {
      "id": "emit-horizon",
      "kind": "action",
      "label": "Emit horizon event",
      "position": { "x": 300, "y": 580 },
      "action": {
        "type": "emit",
        "name": "horizon-revealed",
        "payload": { "experience": "nocterra" }
      }
    },
    {
      "id": "request-private",
      "kind": "trigger",
      "label": "Request private presentation",
      "position": { "x": 40, "y": 740 },
      "event": "click",
      "target": "cta-private-presentation",
      "states": ["idle", "inspecting"]
    },
    {
      "id": "state-inquiry",
      "kind": "state",
      "label": "Inquiry state",
      "position": { "x": 300, "y": 740 },
      "state": "inquiry"
    },
    {
      "id": "emit-inquiry",
      "kind": "action",
      "label": "Emit presentation intent",
      "position": { "x": 560, "y": 740 },
      "action": {
        "type": "emit",
        "name": "private-presentation-intent",
        "payload": { "experience": "nocterra" }
      }
    }
  ],
  "edges": [
    { "id": "detail-engaged", "from": "enter-detail", "to": "mark-engaged", "branch": "always", "priority": 0 },
    { "id": "engaged-inspecting", "from": "mark-engaged", "to": "state-inspecting", "branch": "always", "priority": 0 },
    { "id": "hotspot-inspection", "from": "open-hotspot", "to": "emit-inspection", "branch": "always", "priority": 0 },
    { "id": "threshold-event", "from": "enter-threshold", "to": "emit-threshold", "branch": "always", "priority": 0 },
    { "id": "horizon-event", "from": "enter-horizon", "to": "emit-horizon", "branch": "always", "priority": 0 },
    { "id": "request-inquiry", "from": "request-private", "to": "state-inquiry", "branch": "always", "priority": 0 },
    { "id": "inquiry-event", "from": "state-inquiry", "to": "emit-inquiry", "branch": "always", "priority": 0 }
  ],
  "mobileSubstitutions": []
}

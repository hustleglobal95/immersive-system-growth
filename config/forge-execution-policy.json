{
  "policyId": "forge-full-system-execution",
  "version": 2,
  "automaticForSubstantialCreativeWork": true,
  "explicitTriggers": [
    "USE FORGE"
  ],
  "fullBuild": {
    "requiredStages": [
      "operational-readiness",
      "clean-baseline",
      "state-provenance",
      "reference-classification",
      "external-reference-intelligence",
      "build-packet",
      "director-intelligence",
      "reference-intelligence",
      "creative-state-graph",
      "originality-gate",
      "capability-routing",
      "signature-slice-gate",
      "context-capsules",
      "verification-plan"
    ],
    "requiredPacketSections": [
      "## PROJECT BRIEF",
      "## CONTROLLING THESIS",
      "## PRIMARY SIGNATURE MOMENT",
      "## CREATIVE STATE GRAPH",
      "## SIGNATURE SLICE GATE",
      "## CREATIVE DNA",
      "## ART DIRECTION",
      "## EXTERNAL REFERENCE INTELLIGENCE",
      "## CONSTRUCTION RESEARCH",
      "## SCENE-BY-SCENE CONSTRUCTION PLAN",
      "## CURRENT VALIDATED PROJECT STATE",
      "## AGENTIC EXECUTION MODEL",
      "## ACCEPTANCE CONTRACT",
      "## DEFINITION OF DONE",
      "## HIERARCHY CONTRACT",
      "## ASSET REALITY",
      "## BLOCKERS / UNKNOWNS",
      "## REPOSITORY OPERATING CONTRACT"
    ],
    "requiredContextDomains": [
      "director",
      "composition",
      "camera",
      "motion",
      "typography",
      "interaction",
      "asset",
      "mobile",
      "performance",
      "engineering"
    ],
    "requiredStateInputs": [
      "experience",
      "manifest",
      "graph",
      "cinematic"
    ]
  },
  "creativeChangeControl": {
    "recordDirectory": "forge-intelligence/execution-records",
    "localArtifactDirectory": ".forge/execution",
    "governedPathPatterns": [
      "^app/(?!api/|studio/|director/|type-vault/).*(?:page|layout)\\.tsx$",
      "^src/experiences/",
      "^clients/",
      "^showcases/",
      "^draft-scenes/",
      "^config/(?:experience|interaction-graph|cinematic-systems|asset-manifest)\\.json$",
      "^public/(?:models|textures|videos|images)/"
    ]
  },
  "governanceChangeControl": {
    "separatePullRequestRequired": true,
    "protectedPaths": [
      "config/forge-execution-policy.json",
      "docs/FORGE_EXECUTION_GOVERNANCE.md",
      "scripts/forge-preflight.mjs",
      "scripts/forge-execution-audit.mjs",
      "scripts/agentic-consistency-audit.mjs",
      "CLAUDE.md",
      "AGENTS.md",
      ".claude/skills/forge-build/SKILL.md",
      ".github/workflows/ci.yml",
      ".github/CODEOWNERS",
      ".github/PULL_REQUEST_TEMPLATE.md",
      "tests/forge-execution-governance.test.ts",
      "scripts/forge-readiness.mjs",
      "MANIFEST.md",
      "scripts/lib/reference-intelligence.mjs",
      "scripts/forge-reference-capture.mjs",
      ".claude/commands/study-reference.md",
      "tests/reference-intelligence.test.ts",
      "tests/fixtures/reference-analysis.example.json",
      "tests/fixtures/reference-evidence.svg",
      "scripts/forge-reference-validate.mjs",
      "src/platform/buildPacket.ts",
      "scripts/forge-build-packet.mjs",
      "scripts/forge-context-capsule.mjs",
      "tests/build-packet.test.ts",
      "package.json",
      "src/platform/director-intelligence/referenceCorpus.ts",
      "src/platform/director-intelligence/constructionKnowledge.ts",
      "src/platform/director-intelligence/orchestrator.ts"
    ]
  },
  "referenceDriven": {
    "failOnUnclassifiedUrls": true,
    "requireValidatedAnalysisForReferenceUrls": true,
    "autoCaptureEvidenceWhenAnalysisMissing": true,
    "requireHashedLocalVisualEvidence": true,
    "separateObservedFactsFromHypotheses": true,
    "injectIntoBuildPacketAndDirector": true
  }
}
